  letter-spacing: -0.03em;
}

@keyframes riseIn {
  0% {
    opacity: 0;
    transform: translateY(16px) scale(0.988);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes popPulse {
  0% {
    box-shadow: 0 0 0 0 rgba(11, 127, 115, 0.25);
  }
  70% {
    box-shadow: 0 0 0 12px rgba(11, 127, 115, 0);
  }
  100% {
