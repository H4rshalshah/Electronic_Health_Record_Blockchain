$apps = @(
    # Hospital Backends
    @{ dir = "orgs/hospital/EHR_hospitalOrg-main/ehr-backend-v3/ipfs-service"; cmd = "npm start" },
    @{ dir = "orgs/hospital/EHR_hospitalOrg-main/ehr-backend-v3/peer0-api"; cmd = "npm start" },
