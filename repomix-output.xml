  --secondary: #e8f0ec;
  --secondary-hover: #dce9e3;
  --accent: #d87832;
  --accent-soft: #fff3e7;

  --ring: rgba(11, 127, 115, 0.28);
  --danger: #bc2f2f;
  --success: #1d7f46;

  --font-sans: 'Manrope', 'Segoe UI', sans-serif;
  --font-display: 'Space Grotesk', 'Trebuchet MS', sans-serif;
  --font-mono: 'IBM Plex Mono', 'Consolas', monospace;

  --radius-lg: 20px;
  --radius-md: 12px;
  --radius-sm: 9px;

  --shadow-sm: 0 3px 10px rgba(6, 36, 24, 0.08);
  --shadow-md: 0 18px 42px rgba(14, 41, 31, 0.16);
  --shadow-soft: 0 0 0 1px rgba(255, 255, 255, 0.6) inset;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html,
body {
  min-height: 100%;
  width: 100%;
  overflow-x: hidden;
}

body {
  position: relative;
  min-height: 100vh;
  color: var(--text-main);
  font-family: var(--font-sans);
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
  background:
    radial-gradient(circle at 8% 10%, rgba(54, 186, 152, 0.19), transparent 44%),
    radial-gradient(circle at 88% 88%, rgba(216, 120, 50, 0.19), transparent 48%),
    linear-gradient(160deg, #f1f7f4 0%, #e8f0ec 38%, #eef3f7 100%);
}

body::before,
body::after {
  content: '';
  position: fixed;
  pointer-events: none;
  z-index: -1;
  filter: blur(0.7px);
}

body::before {
  width: min(38vw, 430px);
  height: min(38vw, 430px);
  left: -130px;
  top: -120px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(12, 138, 122, 0.19), transparent 72%);
}

body::after {
  width: min(42vw, 470px);
  height: min(42vw, 470px);
  right: -180px;
  bottom: -150px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(216, 120, 50, 0.16), transparent 74%);
}

::selection {
  color: #ffffff;
  background: #0e8f7f;
}

h1,
h2,
h3 {
