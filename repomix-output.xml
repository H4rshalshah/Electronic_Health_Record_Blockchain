/* Global Glassmorphic Design System v2.0 */
@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&family=JetBrains+Mono&display=swap');

:root {
  --bg: #030712;
  --surface: rgba(17, 24, 39, 0.7);
  --glass: rgba(255, 255, 255, 0.03);
  --border: rgba(255, 255, 255, 0.08);
  --accent-primary: #10b981;
  --accent-secondary: #3b82f6;
  --accent-warning: #eab308;
  --accent-danger: #ef4444;
  --text-primary: #f8fafc;
  --text-secondary: #94a3b8;
  --shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.8);
}

* { box-sizing: border-box; margin: 0; padding: 0; transition: background 0.2s ease, border-color 0.2s ease, opacity 0.2s ease; }

body {
  font-family: 'Outfit', sans-serif;
  background: var(--bg);
  background-image: 
    radial-gradient(circle at 10% 20%, rgba(16, 185, 129, 0.05) 0%, transparent 20%),
    radial-gradient(circle at 90% 80%, rgba(59, 130, 246, 0.05) 0%, transparent 20%);
  color: var(--text-primary);
  min-height: 100vh;
  overflow-x: hidden;
}

.app { min-height: 100vh; display: flex; flex-direction: column; }

/* ── Navigation ─────────────────────────────────────────────────────────────── */
.nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1.25rem 2.5rem;
  background: rgba(3, 7, 18, 0.8);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border);
  position: sticky;
  top: 0;
  z-index: 100;
}

.logo {
  font-size: 1.5rem;
  font-weight: 800;
  letter-spacing: -0.02em;
}

/* ── Layout ──────────────────────────────────────────────────────────────────── */
.app-container {
  max-width: 1200px;
  width: 100%;
  margin: 0 auto;
  padding: 3rem 2rem;
  flex: 1;
}

.grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 2rem;
}

/* ── Glassmorphic Card ───────────────────────────────────────────────────────── */
.glass-card {
  background: var(--surface);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid var(--border);
  border-radius: 1.5rem;
  padding: 2rem;
  box-shadow: var(--shadow);
  position: relative;
}

.glass-card:hover {
  border-color: rgba(255, 255, 255, 0.14);
}

/* ── Typography ──────────────────────────────────────────────────────────────── */
h1, h2, h3 { font-weight: 800; letter-spacing: -0.01em; margin-bottom: 0.5rem; }
h3 { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 1rem; }
h4 { font-weight: 600; }
p { color: var(--text-secondary); line-height: 1.6; }
label { display: block; margin-bottom: 0.35rem; font-size: 0.75rem; color: var(--text-secondary); font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; }

/* ── Tabs ────────────────────────────────────────────────────────────────────── */
.tabs {
  display: flex;
  gap: 0.5rem;
  margin-bottom: 2rem;
  background: rgba(0, 0, 0, 0.3);
  padding: 0.4rem;
  border-radius: 1rem;
  border: 1px solid var(--border);
  width: fit-content;
}

.tab {
  padding: 0.6rem 1.4rem;
  border-radius: 0.75rem;
  cursor: pointer;
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--text-secondary);
  user-select: none;
}

.tab:hover { color: var(--text-primary); background: rgba(255,255,255,0.04); }

.tab.active {
  background: var(--accent-secondary);
  color: white;
}

/* ── Buttons ─────────────────────────────────────────────────────────────────── */
.btn {
  padding: 0.8rem 1.5rem;
  border-radius: 0.75rem;
  border: 1px solid var(--border);
  background: var(--glass);
  color: var(--text-primary);
  font-weight: 600;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  text-decoration: none;
  font-family: 'Outfit', sans-serif;
  font-size: 0.9rem;
}

.btn-primary {
  background: linear-gradient(135deg, var(--accent-primary), #059669);
  border: none;
  color: white;
}

.btn:hover { background: rgba(255, 255, 255, 0.1); }
.btn-primary:hover { filter: brightness(1.1); transform: translateY(-1px); }
.btn:disabled { opacity: 0.5; cursor: not-allowed; transform: none !important; filter: none !important; }

/* ── Forms ───────────────────────────────────────────────────────────────────── */
input, select, textarea {
  width: 100%;
  padding: 0.8rem 1rem;
  background: rgba(0, 0, 0, 0.3);
  border: 1px solid var(--border);
  border-radius: 0.75rem;
  color: white;
  margin-bottom: 1rem;
  font-family: 'Outfit', sans-serif;
  font-size: 0.9rem;
}

input:focus, select:focus, textarea:focus { outline: none; border-color: var(--accent-secondary); box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15); }
select option { background: #1e293b; }

/* ── Badges ──────────────────────────────────────────────────────────────────── */
.badge {
  padding: 0.3rem 0.8rem;
  border-radius: 2rem;
  font-size: 0.7rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  white-space: nowrap;
}

.badge-green {
  background: rgba(16, 185, 129, 0.15);
  color: #10b981;
  border: 1px solid rgba(16, 185, 129, 0.3);
}

.badge-red {
  background: rgba(239, 68, 68, 0.15);
  color: #ef4444;
  border: 1px solid rgba(239, 68, 68, 0.3);
}

.badge-blue {
  background: rgba(59, 130, 246, 0.15);
  color: #3b82f6;
  border: 1px solid rgba(59, 130, 246, 0.3);
}

.badge-yellow {
  background: rgba(234, 179, 8, 0.15);
  color: #eab308;
  border: 1px solid rgba(234, 179, 8, 0.3);
}

/* ── Tables ──────────────────────────────────────────────────────────────────── */
table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.875rem;
}

thead tr {
  border-bottom: 1px solid var(--border);
}

th {
  text-align: left;
  padding: 0.75rem 1rem;
  font-size: 0.7rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--text-secondary);
}

td {
  padding: 0.9rem 1rem;
  border-bottom: 1px solid rgba(255, 255, 255, 0.04);
  color: var(--text-primary);
  vertical-align: middle;
}

tbody tr:hover { background: rgba(255, 255, 255, 0.02); }
tbody tr:last-child td { border-bottom: none; }

/* ── Pulse / Status indicators ───────────────────────────────────────────────── */
.pulse-circle {
  position: relative;
  border-radius: 50%;
  background: var(--accent-primary);
  flex-shrink: 0;
}

.pulse-circle::after {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  border-radius: 50%;
  border: 2px solid var(--accent-primary);
  animation: pulse-ring 2s infinite cubic-bezier(0.4, 0, 0.6, 1);
}

@keyframes pulse-ring {
  0% { transform: scale(0.9); opacity: 0.8; }
  100% { transform: scale(2.2); opacity: 0; }
}

/* ── Animations ──────────────────────────────────────────────────────────────── */
.animate-spin {
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.animate-pulse { animation: breathe 3s infinite ease-in-out; }
@keyframes breathe {
  0%, 100% { opacity: 0.4; }
  50% { opacity: 1; }
}

/* ── Utility ─────────────────────────────────────────────────────────────────── */
code { font-family: 'JetBrains Mono', monospace; font-size: 0.85em; }

/* ── Scrollbar ───────────────────────────────────────────────────────────────── */
::-webkit-scrollbar { width: 6px; height: 6px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }
::-webkit-scrollbar-thumb:hover { background: rgba(255, 255, 255, 0.2); }
