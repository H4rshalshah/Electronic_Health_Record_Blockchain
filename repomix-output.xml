    address:     PEER_ADDR,
    tlsCertPath: TLS_CERT,
    mspPath:     path.join(USERS, 'patientService/msp'),
    mspId:       MSP_ID,
  },
};

function getPeerConfig(role) {
  const c = PEER_MAP[role];
  if (!c) throw new Error(`No peer config for role: '${role}'`);
