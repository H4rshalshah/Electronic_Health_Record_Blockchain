# ==============================================================================
# EHR Blockchain System — Root Environment Configuration Template
# Copy this file to .env or use the respective service-level .env files
# ==============================================================================

NODE_ENV=development
JWT_SECRET=change_this_to_a_secure_random_32_character_string
JWT_EXPIRES_IN=8h

# Hyperledger Fabric Configuration
FABRIC_CHANNEL=ehrchannel
FABRIC_CHAINCODE=ehr
# Optional override (automatically detected via relative path):
# FABRIC_BASE_PATH=./orgs/hospital/EHR_hospitalOrg-main/ehr-network

# Peer Endpoints
PEER0_ADDRESS=localhost:7051   # Hospital Reception / Admin
PEER1_ADDRESS=localhost:9051   # Hospital Doctor
PEER2_ADDRESS=localhost:10051  # Hospital Nurse / Pharmacist
DIAG_PEER_ADDRESS=localhost:8051 # Diagnostics / Lab
PROV_PEER_ADDRESS=localhost:11051 # Insurance Provider

# IPFS Kubo Service Endpoints
IPFS_API_URL=http://localhost:5001
IPFS_GATEWAY_URL=http://localhost:8090
IPFS_SERVICE_URL=http://localhost:4006
IPFS_SERVICE_KEY=change-me-in-production

# Microservice Ports
PORT_PEER0_API=4001
PORT_PEER1_API=4002
PORT_PEER2_API=4003
PORT_EXTORG_API=4004
PORT_PATIENT_API=4005
PORT_IPFS_SERVICE=4006

# Frontend Ports
PORT_HOSPITAL_PORTAL=5173
PORT_PATIENT_PORTAL=5174
PORT_PHARMACY_FRONTEND=5175
